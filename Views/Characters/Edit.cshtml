@model Character

@{
    ViewData["Title"] = "Edit Character";
}

<h1>Edit @Model.Name</h1>

<form asp-action="Edit" method="post" class="col-md-6">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Race" class="form-label"></label>
        <input asp-for="Race" class="form-control" />
        <span asp-validation-for="Race" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HomeLand" class="form-label"></label>
        <input asp-for="HomeLand" class="form-control" />
        <span asp-validation-for="HomeLand" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Age" class="form-label"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
