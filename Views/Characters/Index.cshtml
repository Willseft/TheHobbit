@model List<Character>

@{
    ViewData["Title"] = "Characters";
}

<h1>The Hobbit Characters</h1>

<a asp-action="Create" class="btn btn-primary mb-4">Add Character</a>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var character in Model)
    {
        <div class="col">
            <partial name="_CharacterCard" model="character" />
        </div>
    }
</div>