@model List<Character>

<h1>The Hobbit Characters</h1>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Race</th>
            <th>Homeland</th>
            <th>Age</th>
            <th>Details</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var character in Model)
        {
            <tr>
                <td>@character.Name</td>
                <td>@character.Race</td>
                <td>@character.HomeLand</td>
                <td>@character.Age</td>
                <td>
                    <a href="/Characters/Details/@character.Id">View Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>