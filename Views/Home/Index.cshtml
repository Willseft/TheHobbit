@{
    ViewData["Title"] = "Home";
    var featured = CharacterData.All.First();
}

<div class="text-center">
    <h1 class="display-4">The Hobbit Characters</h1>
    <p>Explore characters from The Hobbit.</p>
</div>

<h2 class="h5 mt-4">Featured Character</h2>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <partial name="_CharacterCard" model="featured" />
    </div>
</div>

@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-05/homework-checks.js"></script>
}